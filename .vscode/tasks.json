{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TuDentaria Backend",
            "type": "shell",
            "command": "./mvnw",
            "args": [
                "spring-boot:run",
                "-Dspring-boot.run.profiles=local",
                "-Dspring-boot.run.arguments=--server.port=8080"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "windows": {
                "command": ".\\mvnw.cmd"
            },
            "problemMatcher": []
        },
        {
            "label": "TuDentaria Frontend",
            "type": "shell",
            "command": "npm",
            "args": [
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": {
                    "API_TARGET": "http://127.0.0.1:8080"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "TuDentaria Iniciar ambos",
            "dependsOn": [
                "TuDentaria Backend",
                "TuDentaria Frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
