{
  "info": {
    "name": "TuDentaria Angular JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Peticiones de referencia. Ajustar IDs de los registros creados antes de ejecutar PUT/DELETE. Las peticiones 401/403 son ejemplos de errores: eliminar/cambiar el token para reproducirlos. No ejecutar la colección completa contra una base real."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "password",
      "value": "Admin123!"
    }
  ],
  "item": [
    {
      "name": "01 POST /api/auth/login (evidencia 200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@tudentaria.com\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
