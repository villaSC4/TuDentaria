      <i class="fas fa-exclamation-circle me-1"></i> <span th:errors="${registro}"></span>
    </div>

    <form th:action="@{/registro}" th:object="${registro}" method="POST" class="mt-2">
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-secondary">Nombre</label>
          <input type="text" th:field="*{nombre}" class="form-control bg-light rounded-2 py-2" placeholder="Tu nombre" required style="font-size: 0.9rem;">
          <div class="text-danger small mt-1" th:if="${#fields.hasErrors('nombre')}" th:errors="*{nombre}"></div>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-secondary">Apellido</label>
