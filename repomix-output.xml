<file path="src/main/resources/templates/admin/doctores.html">
<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tu Dentaria - Plantel de Doctores</title>
  <link rel="icon" th:href="@{/favicon.ico}" type="image/x-icon">
  <!-- Bootstrap & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Estilos del Panel Admin -->
  <link th:href="@{/css/admin.css}" rel="stylesheet">
</head>
<body>

<!-- BACKDROP PARA MÓVILES -->
<div class="sidebar-backdrop"></div>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <a th:href="@{/admin/dashboard}">
      <img th:src="@{/img/logo.png}" alt="Tu Dentaria Logo">
    </a>
    <button class="sidebar-close-btn d-lg-none" id="sidebarClose" aria-label="Cerrar menú">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <div class="sidebar-content">
    <ul class="sidebar-menu">
      <li class="menu-item">
        <a th:href="@{/admin/dashboard}"><i class="fas fa-chart-pie"></i> Dashboard</a>
      </li>

      <li class="menu-header">Atención Clínica</li>
      <li class="menu-item">
        <a th:href="@{/admin/citas}"><i class="fas fa-calendar-check"></i> Gestión de Citas</a>
      </li>

      <li class="menu-header">Personal Médico</li>
      <li class="menu-item active">
        <a th:href="@{/admin/doctores}"><i class="fas fa-user-md"></i> Doctores</a>
      </li>

      <li class="menu-header">Seguridad & Accesos</li>
      <li class="menu-item">
        <a th:href="@{/admin/usuarios}"><i class="fas fa-users-cog"></i> Cuentas de Usuario</a>
      </li>

      <li class="menu-header">Sitio Web</li>
      <li class="menu-item">
        <a th:href="@{/}"><i class="fas fa-external-link-alt"></i> Volver al Portal</a>
      </li>
    </ul>
  </div>

  <div class="sidebar-footer">
    <div class="d-flex align-items-center justify-content-between">
      <div class="small text-muted">v1.2 Clínico</div>
      <span class="badge bg-success-subtle text-success small fw-semibold">Online</span>
    </div>
  </div>
</aside>

<!-- CONTENIDO PRINCIPAL -->
<main class="main-content">

  <!-- TOP BAR -->
  <header class="top-bar">
    <div class="top-bar-left">
      <button class="sidebar-toggle-btn d-lg-none" id="sidebarToggle" aria-label="Abrir menú">
        <i class="fas fa-bars"></i>
      </button>
      <h5 class="top-bar-title m-0">Personal Especialista</h5>
    </div>

    <div class="top-bar-right">
      <div class="user-badge">
        <div class="user-avatar">
          <i class="fas fa-user-shield"></i>
        </div>
        <span class="user-name">Administrador</span>
      </div>

      <form th:action="@{/logout}" method="POST" class="m-0">
        <button type="submit" class="btn btn-outline-danger btn-logout">
          <i class="fas fa-sign-out-alt"></i>
          <span>Salir</span>
        </button>
      </form>
    </div>
  </header>

  <!-- CABECERA DE PÁGINA CON BOTÓN DE ACCIÓN -->
  <div class="page-header">
    <div>
      <h2 class="page-title">Equipo de Odontólogos</h2>
      <p class="page-subtitle">Gestiona los doctores que se muestran en el sitio web institucional</p>
    </div>
    <button class="btn btn-primary-custom px-3 py-2 shadow-sm" onclick="nuevoDoctor()">
      <i class="fas fa-plus-circle me-1.5"></i> Agregar Especialista
    </button>
  </div>

  <!-- ALERTAS -->
  <div th:if="${exito}" class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3 d-flex align-items-center" role="alert" style="background-color: #def7ec; color: #03543f;">
    <i class="fas fa-check-circle fa-lg me-2"></i>
    <span th:text="${exito}"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
  <div th:if="${error}" class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3 d-flex align-items-center" role="alert" style="background-color: #fde8e8; color: #e02424;">
    <i class="fas fa-exclamation-circle fa-lg me-2"></i>
    <span th:text="${error}"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>

  <!-- TABLA DE DOCTORES -->
  <div class="card-table-container">
    <div class="table-responsive">
      <table class="table custom-table align-middle">
        <thead>
        <tr>
          <th style="width: 80px;">Foto</th>
          <th>Nombre y Apellidos</th>
          <th>Especialidad Médica</th>
          <th class="text-end">Acciones</th>
        </tr>
        </thead>
        <tbody>
        <tr th:if="${#lists.isEmpty(doctores)}">
          <td colspan="4" class="text-center py-5 text-muted">
            <i class="fas fa-user-md fa-3x mb-3 text-secondary d-block"></i>
            No hay especialistas registrados en el plantel médico.
          </td>
        </tr>
        <tr th:each="d : ${doctores}">
          <td>
            <div class="position-relative d-inline-block">
              <img th:src="${d.imagen != null} ? @{'/uploads/' + ${d.imagen}} : @{/img/logo.png}"
                   alt="Doctor"
                   class="rounded-circle border shadow-sm"
                   style="width: 46px; height: 46px; object-fit: cover;">
            </div>
          </td>
          <td>
            <div class="fw-bold text-dark" th:text="${d.nombre}">Dr. Alejandro Flores</div>
            <div class="small text-muted">Colegiado TuDentaria</div>
          </td>
          <td>
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 fw-semibold" th:text="${d.especialidad}">Ortodoncia y Cirugía</span>
          </td>
          <td class="text-end">
            <button class="btn btn-sm btn-outline-warning btn-action me-1"
                    th:data-id="${d.id}" th:data-nombre="${d.nombre}"
                    th:data-especialidad-id="${d.especialidadObj != null ? d.especialidadObj.id : ''}"
                    onclick="editarDoctor(this)" title="Editar Doctor">
              <i class="fas fa-edit"></i>
            </button>
            <form th:action="@{/admin/doctores/eliminar/{id}(id=${d.id})}" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar a este doctor del plantel?')">
              <button type="submit" class="btn btn-sm btn-outline-danger btn-action" title="Eliminar Doctor">
                <i class="fas fa-trash-alt"></i>
              </button>
            </form>
          </td>
        </tr>
        </tbody>
      </table>
    </div>
  </div>

</main>

<!-- MODAL FORMULARIO DOCTOR -->
<div class="modal fade" id="modalDoctor" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitulo"><i class="fas fa-user-md me-2"></i>Nuevo Doctor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <form th:action="@{/admin/doctores/guardar}" th:object="${doctor}" method="POST" enctype="multipart/form-data">
        <input type="hidden" th:field="*{id}" id="docId">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre Completo del Especialista</label>
            <input type="text" th:field="*{nombre}" id="docNombre" class="form-control" placeholder="Ej. Dr. Mario Silva" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Especialidad Clínica</label>
            <select name="especialidadId" id="docEspecialidad" class="form-select" required>
              <option value="">Selecciona una especialidad...</option>
              <option th:each="esp : ${especialidades}" th:value="${esp.id}" th:text="${esp.nombre}"></option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Fotografía de Perfil (JPG, PNG)</label>
            <input type="file" name="file" id="docFile" class="form-control" accept="image/*">
            <div class="form-text small text-muted">Recomendado: Imagen cuadrada de alta resolución. Obligatoria para nuevos doctores.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom px-4">
            <i class="fas fa-save me-1"></i> Guardar Doctor
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script th:src="@{/scripts/admin.js}"></script>
<script>
  var bootstrapModal = new bootstrap.Modal(document.getElementById('modalDoctor'));

  function nuevoDoctor() {
      document.getElementById('docId').value = '';
      document.getElementById('docNombre').value = '';
      document.getElementById('docEspecialidad').value = '';
      document.getElementById('docFile').value = '';
      document.getElementById('docFile').required = true;
      document.getElementById('modalTitulo').innerHTML = '<i class="fas fa-user-plus me-2"></i>Agregar Especialista';
      bootstrapModal.show();
  }

  function editarDoctor(btn) {
      document.getElementById('docId').value = btn.getAttribute('data-id');
      document.getElementById('docNombre').value = btn.getAttribute('data-nombre');
      document.getElementById('docEspecialidad').value = btn.getAttribute('data-especialidad-id') || '';
      document.getElementById('docFile').value = '';
      document.getElementById('docFile').required = false;
      document.getElementById('modalTitulo').innerHTML = '<i class="fas fa-user-edit me-2"></i>Editar Especialista';
      bootstrapModal.show();
  }
</script>
</body>
</html>
</file>

