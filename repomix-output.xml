          <div class="text-danger small mt-1" th:if="${#fields.hasErrors('dni')}" th:errors="*{dni}"></div>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-secondary">Celular (9 dígitos)</label>
          <input type="tel" th:field="*{telefono}" maxlength="9" pattern="\d{9}" class="form-control bg-light rounded-2 py-2" placeholder="987654321" required style="font-size: 0.9rem;">
          <div class="text-danger small mt-1" th:if="${#fields.hasErrors('telefono')}" th:errors="*{telefono}"></div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">Correo Electrónico</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 rounded-start-2 text-muted"><i class="far fa-envelope"></i></span>
          <input type="email" th:field="*{email}" class="form-control bg-light border-start-0 rounded-end-2 py-2" placeholder="tu@correo.com" required style="font-size: 0.9rem;">
        </div>
        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('email')}" th:errors="*{email}"></div>
      </div>

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">Contraseña</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 rounded-start-2 text-muted"><i class="fas fa-lock"></i></span>
          <input type="password" id="regPassword" th:field="*{password}" class="form-control bg-light border-start-0 py-2" placeholder="Mínimo 6 caracteres" required style="font-size: 0.9rem;">
          <button class="input-group-text bg-light border-start-0 rounded-end-2 text-muted" type="button" onclick="togglePassword('regPassword', 'regEyeIcon')">
            <i id="regEyeIcon" class="far fa-eye"></i>
          </button>
        </div>
        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('password')}" th:errors="*{password}"></div>
      </div>

      <div class="mb-4">
        <label class="form-label small fw-semibold text-secondary">Confirmar Contraseña</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 rounded-start-2 text-muted"><i class="fas fa-lock"></i></span>
          <input type="password" id="regConfirmPassword" th:field="*{confirmarPassword}" class="form-control bg-light border-start-0 py-2" placeholder="Repite tu contraseña" required style="font-size: 0.9rem;">
          <button class="input-group-text bg-light border-start-0 rounded-end-2 text-muted" type="button" onclick="togglePassword('regConfirmPassword', 'regConfirmEyeIcon')">
            <i id="regConfirmEyeIcon" class="far fa-eye"></i>
          </button>
        </div>
        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('confirmarPassword')}" th:errors="*{confirmarPassword}"></div>
