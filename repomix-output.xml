    <section class="contact-page-section py-5 bg-light">
        <div class="container" style="max-width: 850px;">

            <div class="section-header text-center mb-5">
                <span class="section-subtitle d-block fw-bold mb-2 text-uppercase small" style="color: #00BCD4; letter-spacing: 1.5px;">CONTÁCTANOS</span>
                <h2 class="section-title fw-bold text-uppercase mb-3">Solicita una Cita</h2>
                <p class="section-description text-muted mx-auto" style="max-width: 700px; font-size: 0.9rem;">
                    Completa el siguiente formulario y te contactaremos durante nuestro horario de atención. Si tienes una emergencia dental, por favor llama al <strong class="text-dark">913 359 948</strong>. La atención de urgencia suele prestarse el mismo día.
                </p>
            </div>

            <!-- Alertas de Éxito o Error -->
            <div th:if="${exitoCita}" class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> <span th:text="${exitoCita}"></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <div th:if="${errorCita}" class="alert alert-danger alert-dismissible fade show" role="alert">
