                            </div>
                            <div>
                                <span class="fw-bold text-dark d-block" th:text="${u.nombre + ' ' + u.apellido}">Nombre Usuario</span>
                                <span class="small text-muted" th:text="${u.email}">correo@tudentaria.com</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="text-secondary small font-monospace" th:text="${u.email}">correo@tudentaria.com</span>
                    </td>
                    <td>
                        <span th:each="rol : ${u.roles}"
                              th:class="${rol.nombre == 'ROLE_ADMIN'} ? 'badge bg-danger-subtle text-danger-emphasis border border-danger-subtle me-1 px-2 py-1' : 'badge bg-primary-subtle text-primary-emphasis border border-primary-subtle me-1 px-2 py-1'"
