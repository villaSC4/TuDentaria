                        </button>
                        <form th:action="@{/admin/usuarios/eliminar/{id}(id=${u.id})}" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro de eliminar este usuario?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger btn-action" title="Eliminar Cuenta">
                                <i class="fas fa-trash-alt"></i>
