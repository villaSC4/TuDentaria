        </div>
        <button class="btn btn-primary-custom px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalUsuario" onclick="limpiarFormulario()">
            <i class="fas fa-user-plus me-1.5"></i> Nueva Cuenta
        </button>
    </div>

