    border-radius: 4px;
    transition: transform 0.3s ease;
}

.card-testimonio:hover {
    transform: translateY(-5px);
}

.card-testimonio .card-text {
    font-size: 0.95rem;
    color: #444;
    line-height: 1.6;
}

.user-avatar i {
    color: #333; 
}

.img-testimonio {
    width: 55px !important;  
    height: 55px !important; 
    object-fit: cover;       
    border-radius: 50%;     
    display: inline-block;
}

.card-testimonio h6 {
    font-size: 1.1rem;
    color: #000;
}

.card-testimonio small {
    font-size: 0.85rem;
}


/*  FORMULARIO  */

.contacto {
    background-color: var(--color-fondo-claro);
}

.form-control:focus {
    border-color: var(--color-acento);
    box-shadow: 0 0 0 0.2rem rgba(0, 188, 212, 0.25);
}

.btn-form{
    background-color: var(--color-acento);
    font-size: bold;
}

.btn-form:hover{
    background-color: var(--color-fondo-oscuro);
    color: white;
    transition: all 0.4s;
}

.btn-cita-celeste {
    background-color: #00BCD4;
    color: white !important;  
    border-radius: 8px;        
    transition: all 0.3s ease;
}

.btn-cita-celeste:hover {
    background-color: #0097A7; 
    color: white !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.text-muted.fst-italic {
    font-size: 0.75rem;
    opacity: 0.8;
}

/*  FOOTER  */

.footer {
    background-color: var(--color-fondo-oscuro);
    color: #bdc3c7;
}

.footer h4 {
    color: white;
    margin-bottom: 15px;
}

.footer a {
    color: #bdc3c7;
    text-decoration: none;
}

.footer a:hover {
    color: var(--color-acento);
}

.footer-logo {
    max-width: 150px;
    filter: brightness(0) invert(1);
}

.btn-footer {
    display: inline-block;
    background-color: #00BCD4; 
    color: white !important;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease; 
}

.btn-footer:hover {
    background-color: #0097A7; 
    color: white !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 188, 212, 0.3);
}


.footer-bottom {
    background: rgba(0,0,0,0.2);
}


/* SCROLL UP */
.scroll-up {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 45px;
    height: 45px;
    background-color: var(--color-acento);
    color: white;
    border-radius: 50%;
    text-align: center;
    line-height: 45px;
    font-size: 1.5rem;
    text-decoration: none;
    z-index: 999;
    transition: 0.3s;
}

.scroll-up:hover {
    background-color: var(--color-fondo-oscuro);
    transform: translateY(-5px);
}

.social-section {
    background-color: var(--color-fondo-claro); 
    padding: 60px 0;
}

.social-section .section-title {
    color: var(--color-fondo-oscuro);
    margin-bottom: 40px; 
}

.social-icons-container {
    display: flex;
    justify-content: center; 
    gap: 20px; 
    flex-wrap: wrap; 
}

.social-link {
    flex-basis: 220px; 
    padding: 20px;
    text-align: center;
    color: var(--color-blanco);
    font-size: 1.8rem;
    text-decoration: none;
    background-color: #4B6A88; 
    border-radius: 8px; 
    transition: background-color 0.3s, transform 0.3s;
}

.social-link:hover {
    background-color: var(--color-acento);
    transform: translateY(-5px); 
}



/*  Breakpoint: Tableta (hasta 768px) --- */
@media (max-width: 768px) {

   .carousel-item img {
        height: 50vh;
    }

    .carousel-caption {
        left: 5%;
        right: 5%;
        bottom: 10%;
        max-width: 100%;
        text-align: center;
    }
}


/*  Breakpoint: Móvil (hasta 576px) --- */
@media (max-width: 576px) {
    
    .top-bar .container {
        flex-direction: column;
        gap: 10px;
    }

    .section-title {
        font-size: 2rem;
    }
}

/* ===== Mejoras visuales ===== */
.navbar { backdrop-filter: blur(8px); background: rgba(255,255,255,.92) !important; }
.navbar .nav-link { position: relative; font-weight: 600; }
.navbar .nav-link::after {
    content: ''; position: absolute; left: 16px; right: 16px; bottom: 2px;
    height: 2px; background: var(--color-acento);
    transform: scaleX(0); transition: transform .3s;
}
.navbar .nav-link:hover::after, .navbar .nav-link.active::after { transform: scaleX(1); }
.navbar a.nav-link.active { background: transparent; color: var(--color-acento); }

.hero h1 { text-shadow: 0 4px 20px rgba(0,0,0,.5); letter-spacing: .5px; }
.hero-overlay { background: linear-gradient(135deg, rgba(31,75,97,.65), rgba(0,0,0,.45)); }

.service-card > div, .team-section .card, .card-testimonio {
    transition: transform .3s ease, box-shadow .3s ease;
}
.service-card > div:hover, .team-section .card:hover, .services-section .col-md-4 > div:first-child:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(31,75,97,.15) !important;
}
.team-section .card { overflow: hidden; border-radius: 12px; }
.team-section .card img { transition: transform .5s; }
.team-section .card:hover img { transform: scale(1.06); }

.section-title { position: relative; padding-bottom: 14px; }
.section-title::after {
    content: ''; display: block; width: 60px; height: 3px;
    background: var(--color-acento); margin: 12px auto 0; border-radius: 2px;
}
.contact-form { border-top: 4px solid var(--color-acento); }
.btn-info, .btn-cita-celeste { box-shadow: 0 4px 12px rgba(0,188,212,.3); }
html { scroll-behavior: smooth; }
</file>

