              <i class="fas fa-calendar-check fa-lg"></i>
            </div>
            <div>
              <div class="fw-bold text-dark small">Revisar Solicitudes de Cita</div>
              <div class="text-muted" style="font-size: 0.75rem;">Gestionar estados y notas</div>
            </div>
          </div>
        </a>
      </div>

      <div class="col-12 col-md-4">
        <a th:href="@{/admin/doctores}" class="text-decoration-none">
          <div class="p-3 border rounded-3 bg-light hover-shadow transition d-flex align-items-center gap-3">
            <div class="p-2 rounded-2 bg-info-subtle text-info">
              <i class="fas fa-user-md fa-lg"></i>
            </div>
            <div>
              <div class="fw-bold text-dark small">Plantel de Especialistas</div>
              <div class="text-muted" style="font-size: 0.75rem;">Agregar o editar doctores</div>
