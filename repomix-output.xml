                            <div class="col-md-6 form-group">
                                <label class="form-label small fw-semibold text-muted">Hora (Citas en punto)</label>
                                <select th:field="*{hora}" class="form-select rounded-1 border-secondary-subtle py-2.5" style="font-size: 0.9rem;">
