            <div class="p-2 rounded-2 bg-success-subtle text-success">
              <i class="fas fa-users-cog fa-lg"></i>
            </div>
            <div>
              <div class="fw-bold text-dark small">Administrar Cuentas</div>
              <div class="text-muted" style="font-size: 0.75rem;">Roles y accesos del sistema</div>
            </div>
