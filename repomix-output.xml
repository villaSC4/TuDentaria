                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>

            <!-- Formulario Vinculado a la misma acción de guardar -->
            <form th:action="@{/solicitar-cita}" th:object="${solicitud}" method="POST" class="contact-form bg-white p-4 p-md-5 shadow-sm" style="border-radius: 8px;">
                <input type="hidden" name="origen" value="contacto">
                <div class="row g-4">

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Nombre</label>
                        <input type="text" th:field="*{nombre}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Nombre" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('nombre')}" th:errors="*{nombre}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Apellido</label>
                        <input type="text" th:field="*{apellido}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Apellido" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('apellido')}" th:errors="*{apellido}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">DNI (8 dígitos)</label>
                        <input type="text" th:field="*{dni}" maxlength="8" pattern="\d{8}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Ej. 12345678" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('dni')}" th:errors="*{dni}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Teléfono Celular (9 dígitos)</label>
                        <input type="tel" th:field="*{telefono}" maxlength="9" pattern="\d{9}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Ej. 987654321" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('telefono')}" th:errors="*{telefono}"></div>
                    </div>

                    <div class="col-md-12 form-group">
                        <label class="form-label small fw-semibold text-muted">Correo Electrónico</label>
                        <input type="email" th:field="*{email}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="tu@correo.com" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('email')}" th:errors="*{email}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Especialista (Opcional)</label>
                        <select th:field="*{doctorId}" class="form-select rounded-1 border-secondary-subtle py-2.5" style="font-size: 0.9rem;">
                            <option value="">Cualquier especialista disponible</option>
                            <option th:each="doc : ${doctores}" th:value="${doc.id}" th:text="${doc.nombre + (doc.especialidad != null ? ' - ' + doc.especialidad : '')}"></option>
                        </select>
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('doctorId')}" th:errors="*{doctorId}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Tratamiento (Opcional)</label>
                        <select th:field="*{tratamientoId}" class="form-select rounded-1 border-secondary-subtle py-2.5" style="font-size: 0.9rem;">
                            <option value="">Seleccionar tratamiento dental</option>
                            <option th:each="trat : ${tratamientos}" th:value="${trat.id}" th:text="${trat.nombre}"></option>
                        </select>
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('tratamientoId')}" th:errors="*{tratamientoId}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Fecha de Cita</label>
                        <input type="date" th:field="*{fecha}" class="form-control rounded-1 border-secondary-subtle py-2.5" style="font-size: 0.9rem; color: #6c757d;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('fecha')}" th:errors="*{fecha}"></div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="form-label small fw-semibold text-muted">Hora (Citas en punto)</label>
                        <select th:field="*{hora}" class="form-select rounded-1 border-secondary-subtle py-2.5" style="font-size: 0.9rem;">
                            <option value="">Selecciona hora</option>
                            <option value="08:00">08:00 AM (L-V)</option>
                            <option value="09:00">09:00 AM</option>
                            <option value="10:00">10:00 AM</option>
                            <option value="11:00">11:00 AM</option>
                            <option value="12:00">12:00 PM</option>
                            <option value="13:00">01:00 PM (L-V)</option>
                            <option value="14:00">02:00 PM (L-V)</option>
                            <option value="15:00">03:00 PM (L-V)</option>
                            <option value="16:00">04:00 PM (L-V)</option>
                            <option value="17:00">05:00 PM (L-V)</option>
                        </select>
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('hora')}" th:errors="*{hora}"></div>
                    </div>

                    <div class="col-12 form-group">
                        <label class="form-label small fw-semibold text-muted">Motivo de tu consulta</label>
                        <input type="text" th:field="*{motivo}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Ej. Dolor de muela, revisión general, profilaxis" style="font-size: 0.9rem;">
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('motivo')}" th:errors="*{motivo}"></div>
                    </div>

                    <div class="col-12 form-group">
                        <label class="form-label small fw-semibold text-muted">Notas adicionales para el doctor</label>
                        <textarea th:field="*{notas}" class="form-control rounded-1 border-secondary-subtle py-2.5" placeholder="Notas o detalles adicionales para el doctor..." rows="4" style="font-size: 0.9rem; resize: none;"></textarea>
                        <div class="text-danger small mt-1" th:if="${#fields.hasErrors('notas')}" th:errors="*{notas}"></div>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button type="submit" class="btn btn-outline-dark px-5 py-2.5 fw-bold rounded-1 btn-form text-uppercase"
                                style="transition: 0.3s; letter-spacing: 1px; font-size: 0.9rem;"
                                onmouseover="this.style.backgroundColor='#00BCD4'; this.style.borderColor='#00BCD4'; this.style.color='white'"
                                onmouseout="this.style.backgroundColor='transparent'; this.style.borderColor='#212529'; this.style.color='#212529'">
                            SOLICITAR CITA
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </section>

    <section class="social-section py-5 bg-white">
        <div class="container text-center">
            
            <div class="section-header mb-4">
                <h2 class="section-title fw-bold" style="color: #2C3E50; font-size: 2rem;">Nuestras Redes</h2>
