      <button type="submit" class="btn w-100 py-2.5 fw-bold text-white text-uppercase mb-3 rounded-2 shadow-sm" style="background-color: #00BCD4; border-color: #00BCD4; transition: 0.3s; font-size: 0.9rem; letter-spacing: 0.5px;">
