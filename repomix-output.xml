                <tr th:each="u : ${usuarios}">
                    <td>
                        <span class="badge bg-light text-muted border font-monospace" th:text="${'#' + u.id}">#1</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2.5">
